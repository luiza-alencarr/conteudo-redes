# Supabase
# URL e chaves do projeto: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — NUNCA expor no client, usar apenas em código server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Instagram Graph API (Meta for Developers > seu app > Instagram)
# App ID e App Secret: painel do app em developers.facebook.com
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Token de acesso de longa duração (~60 dias). Gere um de curta duração no
# Graph API Explorer e troque com `npm run instagram:exchange-token`.
INSTAGRAM_ACCESS_TOKEN=

# ID da conta comercial/criador do Instagram conectada à Página do Facebook.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
